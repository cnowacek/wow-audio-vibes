<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WoWAudioVibes</AssemblyName>
    <RootNamespace>AudioVibes.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- scripts/release.ps1 passes -p:Version=x.y.z; this is the version of local builds. -->
    <Version>1.3.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>WoW Audio Vibes</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioVibes.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\protocol\zones.json" LogicalName="AudioVibes.zones.json" />
  </ItemGroup>
  <!-- A copy of the addon ships next to the exe (addon\AudioVibes), so Settings can install it into WoW.
       Resolved.lua is left out: it's per machine, and the installer keeps the player's own. -->
  <ItemGroup>
    <Content Include="..\..\..\addon\AudioVibes\**\*" Exclude="..\..\..\addon\AudioVibes\Resolved.lua;..\..\..\addon\AudioVibes\**\*.tmp"
             Link="addon\AudioVibes\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioVibes.Audio\AudioVibes.Audio.csproj" />
    <ProjectReference Include="..\AudioVibes.Decoder\AudioVibes.Decoder.csproj" />
    <ProjectReference Include="..\AudioVibes.Spotify\AudioVibes.Spotify.csproj" />
  </ItemGroup>
</Project>
